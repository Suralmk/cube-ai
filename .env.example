# APP
NODE_ENV=development
PORT=8000
APP_NAME=Cube AI
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1

# DATABASE (Postgres via Prisma/TypeORM)
DATABASE_URL=postgresql://user:password@localhost:5432/cube_ai
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=cube_ai
DB_SYNCHRONIZE=false
DB_LOGGING=true


# AWS S3 (STORAGE)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=cube-ai-storage
AWS_S3_PUBLIC_URL=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_SIGNED_URL_EXPIRY=3600

# CORS
CORS_ORIGIN=http://localhost:3000

# LOGGING
LOG_LEVEL=debug

# OPEN Router (chat + embeddings share one key)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
BETTER_AUTH_SECRET=your_secret_key_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# VECTOR STORE (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# CHAT + RAG
CHAT_HISTORY_LIMIT=5
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# LOCAL DOCUMENT STORAGE (dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage